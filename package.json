{
  "name": "seth-content-engine",
  "version": "1.0.0",
  "description": "Scheduled Instagram research and script adaptation pipeline for Seth Caslin",
  "scripts": {
    "discover": "node --experimental-sqlite --no-warnings --import tsx src/cli.ts discover",
    "publish": "node --experimental-sqlite --no-warnings --import tsx src/cli.ts publish",
    "status": "node --experimental-sqlite --no-warnings --import tsx src/cli.ts status",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-sqlite --no-warnings --import tsx scripts/test.ts",
    "guard": "node --experimental-sqlite --no-warnings --import tsx src/cli.ts guard",
    "notify-failure": "node --experimental-sqlite --no-warnings --import tsx src/cli.ts notify-failure",
    "prune": "node --experimental-sqlite --no-warnings --import tsx src/cli.ts prune"
  },
